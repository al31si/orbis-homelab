# Orbis Homelab - secrets and deployment variables only.
#
# Copy this file to .env next to compose.yaml and restrict it: chmod 600 .env
# Never commit .env. Everything else (addresses, names, access rules) belongs in config/config.yaml.
#
# A secret that is empty or missing means "not configured": the integration is shown as such,
# it is not an error. Variables are read by the names used in services.yaml: the default for an
# integration is <TYPE>_API_KEY (VIKUNJA_API_TOKEN for vikunja), or the name given in
# `secret: { env: NAME }`.

# --- Integration credentials ---------------------------------------------------------------
# Only fill in the ones you use. They are used for GET requests only.

# Radarr, Sonarr, Lidarr, Prowlarr: Settings > General > API key.
RADARR_API_KEY=
# Second instance used by the `radarr-4k` entry of services.example.yaml.
RADARR_4K_API_KEY=
# SONARR_API_KEY=
# LIDARR_API_KEY=
# PROWLARR_API_KEY=
# qBittorrent: the API key of the web UI. It cannot be restricted: rotate it if it leaks.
# QBITTORRENT_API_KEY=
# Jellyfin: Dashboard > API keys. It grants broad access; Orbis Homelab only calls GET /Sessions.
JELLYFIN_API_KEY=
# Vikunja: Settings > API tokens. Create one with read-only access to tasks and projects.
# VIKUNJA_API_TOKEN=

# --- Deployment ------------------------------------------------------------------------------
# Image tag used by compose.yaml. REQUIRED and with no default on purpose: the image must be the
# release of the compose.yaml and example files you downloaded, so the Quick Start in README.md
# appends this line for you. Use an exact version (1.2.3); 1.2, 1 or latest also work but may pull
# an image newer than your files.
# ORBIS_VERSION=1.2.3
# Host port of this installation (default 3100). Give every installation on the same machine its
# own port: the project name is the folder name, so they do not clash otherwise.
# ORBIS_PORT=3100
# Project name of this installation (default: the name of this folder). Set it when another
# installation lives in a folder with the same name, otherwise Compose treats them as one.
# COMPOSE_PROJECT_NAME=orbis-homelab-lab
# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
